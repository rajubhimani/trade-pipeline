# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local dev secrets — never commit real keys
keys/*.pem

# Local env overrides — any *.env file (.env, docker-compose.env, or a
# differently-named setup someone adds later) is ignored by this one glob.
# .env.example — the single tracked template for all of them — doesn't
# match it (ends in .example, not .env) and stays tracked.
*.env

# Local stand-in for S3 cold storage (dagster_pipeline/archival.py) — generated data, not source
archive/

# Dashboard build output — generated by `npm run build` in dashboard/, not source
src/trade_pipeline/api/static/
