# Copy to .env and edit as needed for local development. Every value here is
# already the default (matches docker-compose.yml) — this file exists so
# every available setting is discoverable in one place, not because any of
# these need to change for a stock local setup.
#
# Precedence: real environment variables (set by your shell or the
# deployment environment) always win over .env, which wins over the
# baked-in defaults in common/config.py / api/settings.py.

# --- Kafka (common/config.py: KafkaSettings) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=trades

# --- Redis (common/config.py: RedisSettings) ---
REDIS_URL=redis://localhost:6379/0
REDIS_DEDUP_TTL_SECONDS=300

# --- Postgres (common/config.py: PostgresSettings) ---
# Async DSN (asyncpg) — used by the API. The consumer's sync sink swaps the
# driver to +psycopg itself (see postgres_sink.py), no separate var needed.
POSTGRES_DSN=postgresql+asyncpg://trade_pipeline:trade_pipeline@localhost:5432/trade_pipeline

# --- API (api/settings.py: ApiEnvSettings) ---
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
CORS_ORIGINS=http://localhost:3000

# --- Feature flags (defaults are DB-backed, not env — see common/feature_flags.py) ---
# Nothing to set here; flags live in the feature_flags table, not the environment.
