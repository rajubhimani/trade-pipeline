# Single template for every target this code runs against — copy it to
# whatever *.env filename fits the situation (all *.env files are gitignored;
# see .gitignore) and edit the values for that target, same variable names
# throughout since it's the same pydantic-settings classes (common/config.py)
# reading them either way:
#
#   - `.env` — running code directly on the host (this file's values as-is:
#     everything defaults to `localhost`, matching `docker-compose up -d`
#     with just the infra services published to your host machine).
#   - `docker-compose.env` — the full containerized stack (`make up` /
#     `docker compose up -d --build`, referenced via `env_file:` in
#     docker-compose.yml). Swap every `localhost` below for the matching
#     Compose service DNS name instead: `postgres`, `redis`, `kafka`,
#     `temporal` — containers can't reach each other via `localhost`, that
#     means "myself" inside a container.
#   - anything else (`staging.env`, a teammate's own setup, ...) — same
#     idea: same variable names, different host/port/credentials for
#     wherever that Postgres/Redis/Kafka/Temporal/enrichment service
#     actually lives.
#
# Precedence: real environment variables (set by your shell, Docker's
# `env_file:`, or the deployment environment) always win over whichever
# *.env file you point a process at, which wins over the baked-in defaults
# in common/config.py / api/settings.py.

# --- Kafka (common/config.py: KafkaSettings) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=trades

# --- Redis (common/config.py: RedisSettings) ---
# Split into fields, not one URL — a real managed Redis just overrides
# REDIS_HOST/REDIS_PASSWORD individually instead of rebuilding a whole URL.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Empty locally (docker-compose's redis service runs with no auth) — set
# this for a real managed Redis that requires one.
REDIS_PASSWORD=
REDIS_DEDUP_TTL_SECONDS=300

# --- Postgres (common/config.py: PostgresSettings) ---
# Split into fields, not one DSN — same reasoning as Redis above. The API
# and Temporal worker use the async (asyncpg) DSN built from these; the
# consumer's sync sink and one-shot scripts use the sync (psycopg) DSN
# instead (both derived from the same fields, see PostgresSettings.dsn /
# .sync_dsn — no separate var needed for the driver difference).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trade_pipeline
POSTGRES_PASSWORD=trade_pipeline
POSTGRES_DB=trade_pipeline

# --- Temporal (common/config.py: TemporalSettings) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=trade-pipeline
# How often the outbox dispatcher polls trade_enrichment_jobs for rows still
# pending (see enrichment/outbox.py).
TEMPORAL_OUTBOX_POLL_INTERVAL_SECONDS=0.5

# --- Enrichment services (common/config.py: EnrichmentSettings) ---
# Both absent by default — enrichment/services.py falls back to a
# deterministic demo handler (varies by trade) for any service with no URL
# configured here. Set either to point the Temporal worker at a real HTTP
# enrichment service instead.
ENRICHMENT_RISK_SCORE_URL=
ENRICHMENT_SENTIMENT_URL=

# --- API (api/settings.py: ApiEnvSettings) ---
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
CORS_ORIGINS=http://localhost:3000

# --- Feature flags (defaults are DB-backed, not env — see common/feature_flags.py) ---
# Nothing to set here; flags live in the feature_flags table, not the environment.
